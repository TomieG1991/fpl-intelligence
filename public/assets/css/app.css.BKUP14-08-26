/*
 * ============================================================
 * FPL INTELLIGENCE
 * APPLICATION STYLES
 * ============================================================
 */


/*
 * ============================================================
 * RESET
 * ============================================================
 */

* {
    box-sizing: border-box;
}


html {
    margin: 0;
    padding: 0;
}


body {
    margin: 0;

    min-height: 100vh;

    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background:
        #0c111d;

    color:
        #e6eaf2;
}


a {
    color: inherit;
    text-decoration: none;
}


/*
 * ============================================================
 * APPLICATION SHELL
 * ============================================================
 */

.app-shell {
    display: flex;

    min-height: 100vh;
}


/*
 * ============================================================
 * SIDEBAR
 * ============================================================
 */

.sidebar {
    position: fixed;

    top: 0;
    left: 0;
    bottom: 0;

    width: 250px;

    display: flex;
    flex-direction: column;

    padding: 28px 20px;

    background:
        #121827;

    border-right:
        1px solid #263044;
}


.brand {
    display: flex;

    align-items: center;

    gap: 12px;

    margin-bottom: 42px;
}


.brand-mark {
    width: 42px;
    height: 42px;

    display: flex;

    align-items: center;
    justify-content: center;

    border-radius: 10px;

    font-weight: 800;

    background:
        #6f5cff;

    color:
        #ffffff;
}


.brand-name {
    font-size: 15px;
    font-weight: 700;
}


.brand-version {
    margin-top: 2px;

    font-size: 11px;

    color:
        #7f8ba3;
}


.main-navigation {
    display: flex;

    flex-direction: column;

    gap: 6px;
}


.nav-link {
    display: flex;

    align-items: center;

    gap: 12px;

    padding: 11px 13px;

    border-radius: 8px;

    color:
        #8f9bb2;

    font-size: 14px;
    font-weight: 500;

    transition:
        background 0.15s ease,
        color 0.15s ease;
}


.nav-link:hover {
    background:
        #1a2233;

    color:
        #ffffff;
}


.nav-link.active {
    background:
        #222c42;

    color:
        #ffffff;
}


.nav-icon {
    width: 20px;

    text-align: center;

    color:
        #8f7cff;
}


.sidebar-footer {
    margin-top: auto;

    display: flex;

    align-items: center;

    gap: 8px;

    padding-top: 20px;

    border-top:
        1px solid #263044;

    font-size: 12px;

    color:
        #8490a7;
}


/*
 * ============================================================
 * MAIN CONTENT
 * ============================================================
 */

.app-content {
    width: calc(100% - 250px);

    margin-left: 250px;

    min-height: 100vh;
}


/*
 * ============================================================
 * TOPBAR
 * ============================================================
 */

.topbar {
    min-height: 100px;

    display: flex;

    align-items: center;
    justify-content: space-between;

    padding:
        25px
        36px;

    background:
        #0f1522;

    border-bottom:
        1px solid #202a3c;
}


.topbar h1 {
    margin: 2px 0 0;

    font-size: 28px;
    font-weight: 700;
}


.eyebrow {
    margin: 0;

    color:
        #777fff;

    font-size: 11px;

    font-weight: 700;

    letter-spacing: 0.12em;

    text-transform: uppercase;
}


.topbar-actions {
    display: flex;

    align-items: center;

    gap: 12px;
}


.data-status {
    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding:
        8px
        12px;

    border:
        1px solid #273247;

    border-radius:
        999px;

    color:
        #99a5ba;

    font-size:
        12px;
}


/*
 * ============================================================
 * STATUS DOT
 * ============================================================
 */

.status-dot {
    width: 8px;
    height: 8px;

    display: inline-block;

    border-radius: 50%;
}


.status-dot.online {
    background:
        #4bd18b;
}


.status-dot.offline {
    background:
        #e65f6d;
}


/*
 * ============================================================
 * DASHBOARD
 * ============================================================
 */

.dashboard {
    padding:
        34px
        36px
        50px;
}


/*
 * ============================================================
 * STAT CARDS
 * ============================================================
 */

.stats-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 18px;

    margin-bottom: 24px;
}


.stat-card {
    padding: 22px;

    background:
        #141b2a;

    border:
        1px solid #253047;

    border-radius:
        12px;
}


.stat-label {
    color:
        #8490a7;

    font-size:
        12px;

    font-weight:
        600;
}


.stat-value {
    margin-top: 9px;

    font-size:
        30px;

    font-weight:
        750;

    letter-spacing:
        -0.03em;
}


.stat-value-small {
    font-size:
        23px;
}


.stat-footer {
    margin-top: 8px;

    color:
        #647088;

    font-size:
        11px;
}


/*
 * ============================================================
 * DASHBOARD CARDS
 * ============================================================
 */

.dashboard-grid {
    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 20px;

    margin-bottom:
        20px;
}


.dashboard-card {
    padding:
        22px;

    background:
        #141b2a;

    border:
        1px solid #253047;

    border-radius:
        12px;
}


.card-header {
    display: flex;

    align-items: flex-start;
    justify-content: space-between;

    gap:
        20px;

    margin-bottom:
        22px;
}


.card-header h2 {
    margin:
        2px
        0
        0;

    font-size:
        18px;
}


.card-kicker {
    margin: 0;

    color:
        #777fff;

    font-size:
        10px;

    font-weight:
        700;

    letter-spacing:
        0.1em;

    text-transform:
        uppercase;
}


.card-badge {
    display: inline-flex;

    align-items: center;

    padding:
        5px
        9px;

    border-radius:
        999px;

    background:
        #202944;

    color:
        #9f9cff;

    font-size:
        10px;

    font-weight:
        700;
}


/*
 * ============================================================
 * EMPTY STATES
 * ============================================================
 */

.empty-state {
    min-height:
        190px;

    display:
        flex;

    flex-direction:
        column;

    align-items:
        center;

    justify-content:
        center;

    padding:
        25px;

    text-align:
        center;

    border:
        1px dashed #2a3449;

    border-radius:
        9px;

    background:
        #111725;
}


.empty-icon {
    width:
        42px;

    height:
        42px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    margin-bottom:
        12px;

    border-radius:
        9px;

    background:
        #1b2440;

    color:
        #9183ff;

    font-size:
        20px;

    font-weight:
        700;
}


.empty-state h3 {
    margin:
        0
        0
        7px;

    font-size:
        14px;
}


.empty-state p {
    max-width:
        330px;

    margin:
        0;

    color:
        #737f96;

    font-size:
        12px;

    line-height:
        1.6;
}


/*
 * ============================================================
 * SYSTEM STATUS
 * ============================================================
 */

.system-card {
    margin-top:
        0;
}


.system-grid {
    display:
        grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap:
        12px;
}


.system-item {
    display:
        flex;

    flex-direction:
        column;

    gap:
        6px;

    padding:
        15px;

    background:
        #111725;

    border-radius:
        8px;
}


.system-item span {
    color:
        #7d899e;

    font-size:
        11px;
}


.system-item strong {
    font-size:
        13px;
}


.status-success {
    color:
        #55d99a;
}


.status-error {
    color:
        #ef6f7b;
}


/*
 * ============================================================
 * FOOTER
 * ============================================================
 */

.footer {
    display:
        flex;

    justify-content:
        space-between;

    padding:
        20px
        36px;

    border-top:
        1px solid #202a3c;

    color:
        #56637a;

    font-size:
        11px;
}


/*
 * ============================================================
 * RESPONSIVE
 * ============================================================
 */

@media (
    max-width: 1100px
) {

    .stats-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }


    .system-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}


@media (
    max-width: 800px
) {

    .sidebar {
        position:
            static;

        width:
            100%;

        padding:
            20px;
    }


    .app-shell {
        display:
            block;
    }


    .app-content {
        width:
            100%;

        margin-left:
            0;
    }


    .main-navigation {
        flex-direction:
            row;

        overflow-x:
            auto;
    }


    .sidebar-footer {
        display:
            none;
    }


    .dashboard-grid {
        grid-template-columns:
            1fr;
    }


    .topbar {
        padding:
            22px;
    }


    .dashboard {
        padding:
            22px;
    }


    .footer {
        padding:
            20px
            22px;
    }
}


@media (
    max-width: 560px
) {

    .stats-grid {
        grid-template-columns:
            1fr;
    }


    .system-grid {
        grid-template-columns:
            1fr;
    }


    .topbar {
        align-items:
            flex-start;

        gap:
            20px;
    }


    .data-status {
        display:
            none;
    }
}

/*
 * ============================================================
 * PLAYER RANKINGS
 * ============================================================
 */

.player-ranking {
    display:
        flex;

    flex-direction:
        column;
}


.player-ranking-row {
    display:
        flex;

    align-items:
        center;

    gap:
        14px;

    min-height:
        68px;

    padding:
        12px
        4px;

    border-bottom:
        1px solid #222c3f;
}


.player-ranking-row:last-child {
    border-bottom:
        0;
}


.player-rank {
    width:
        32px;

    height:
        32px;

    flex-shrink:
        0;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    border-radius:
        8px;

    background:
        #1b2440;

    color:
        #9a8dff;

    font-size:
        12px;

    font-weight:
        800;
}


.player-details {
    flex:
        1;

    min-width:
        0;
}


.player-name {
    overflow:
        hidden;

    color:
        #f0f3f9;

    font-size:
        13px;

    font-weight:
        650;

    text-overflow:
        ellipsis;

    white-space:
        nowrap;
}


.player-meta {
    display:
        flex;

    flex-wrap:
        wrap;

    gap:
        6px;

    margin-top:
        5px;

    color:
        #68768e;

    font-size:
        10px;
}


.player-meta span:not(:last-child)::after {
    margin-left:
        6px;

    color:
        #3f4a60;

    content:
        "•";
}


.player-score {
    flex-shrink:
        0;

    text-align:
        right;
}


.score-value {
    color:
        #9a8dff;

    font-size:
        18px;

    font-weight:
        800;
}


.score-label {
    margin-top:
        2px;

    color:
        #6f7b91;

    font-size:
        9px;

    font-weight:
        700;

    letter-spacing:
        0.06em;

    text-transform:
        uppercase;
}

.player-components {
    display:
        flex;

    flex-wrap:
        wrap;

    gap:
        10px;

    margin-top:
        7px;

    color:
        #56647c;

    font-size:
        9px;

    font-weight:
        700;
}


.player-components span {
    display:
        inline-flex;

    gap:
        3px;

    align-items:
        center;
}


.player-components strong {
    color:
        #8f9bb2;

    font-weight:
        700;
}

.player-strength-components {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;

    margin-top: 5px;

    color: #4f5d75;

    font-size: 9px;
    font-weight: 700;
}

.player-strength-components span {
    display: inline-flex;
    align-items: center;
    gap: 3px;
}

.player-strength-components strong {
    color: #7d899f;
    font-weight: 700;
}

/*
 * ============================================================
 * POSITION STRENGTH DIAGNOSTIC
 * ============================================================
 */

.strength-diagnostic {
    margin-top: 20px;
}


.position-strength-grid {
    display: grid;

    grid-template-columns:
        repeat(4, minmax(0, 1fr));

    gap: 16px;
}


.position-strength-group {
    padding: 16px;

    background: #111725;

    border-radius: 9px;
}


.position-strength-group h3 {
    margin: 0 0 12px;

    color: #9a8dff;

    font-size: 12px;

    letter-spacing: 0.08em;
}


.position-strength-row {
    display: grid;

    grid-template-columns:
        24px
        minmax(0, 1fr)
        auto;

    align-items: center;

    gap: 8px;

    padding: 8px 0;

    border-bottom:
        1px solid #222c3f;

    font-size: 11px;
}


.position-strength-row:last-child {
    border-bottom: 0;
}


.position-strength-rank {
    color: #59667d;
}


.position-strength-name {
    overflow: hidden;

    text-overflow: ellipsis;

    white-space: nowrap;
}


.position-strength-row strong {
    color: #9a8dff;
}


@media (
    max-width: 1100px
) {

    .position-strength-grid {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }
}


@media (
    max-width: 560px
) {

    .position-strength-grid {
        grid-template-columns:
            1fr;
    }
}

/*
 * ============================================================
 * PLAYER EXPLORER
 * ============================================================
 */

.page-description {
    max-width: 680px;
    margin: 8px 0 0;

    color: #7f8ba3;

    font-size: 13px;
    line-height: 1.6;
}


.explorer-summary {
    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 16px;

    margin-bottom: 20px;
}


.explorer-stat {
    display: flex;
    flex-direction: column;

    gap: 7px;
}


.explorer-stat span {
    color: #7f8ba3;

    font-size: 10px;
    font-weight: 700;

    letter-spacing: 0.08em;

    text-transform: uppercase;
}


.explorer-stat strong {
    font-size: 22px;
}


.player-explorer-card {
    overflow: hidden;
}


.player-table-wrapper {
    overflow-x: auto;

    margin-top: 14px;
}


.player-table {
    width: 100%;

    border-collapse: collapse;

    font-size: 12px;
}


.player-table th {
    padding: 11px 10px;

    color: #66738a;

    border-bottom:
        1px solid #263044;

    font-size: 9px;
    font-weight: 800;

    letter-spacing: 0.08em;

    text-align: left;
    text-transform: uppercase;

    white-space: nowrap;
}


.player-table td {
    padding: 12px 10px;

    border-bottom:
        1px solid #1c2535;

    vertical-align: middle;
}


.player-table tbody tr:last-child td {
    border-bottom: 0;
}


.player-table tbody tr:hover {
    background:
        rgba(
            255,
            255,
            255,
            0.02
        );
}


.rank-column {
    width: 38px;

    color: #59667d;
}


.player-name-cell {
    min-width: 150px;
}


.position-badge {
    display: inline-flex;

    min-width: 36px;

    justify-content: center;

    padding: 4px 7px;

    background: #171e2c;

    border:
        1px solid #283349;

    border-radius: 5px;

    font-size: 9px;
    font-weight: 800;
}


.rating-high {
    color: #8ed7a4;
}


.rating-medium {
    color: #e4c978;
}


.rating-low {
    color: #d98f8f;
}


.rating-none {
    color: #59667d;
}


.intelligence-score {
    font-size: 13px;
}


.empty-table {
    padding: 30px !important;

    color: #66738a;

    text-align: center;
}


@media (
    max-width: 800px
) {

    .explorer-summary {
        grid-template-columns:
            1fr;
    }
}

/*
 * ============================================================
 * PLAYER EXPLORER FILTERS
 * ============================================================
 */

.player-filters {
    display: grid;

    grid-template-columns:
        minmax(160px, auto)
        minmax(210px, 2fr)
        minmax(150px, 1fr)
        minmax(120px, 1fr)
        minmax(140px, 1fr)
        minmax(135px, 1fr)
        minmax(125px, 1fr)
        minmax(250px, auto)
        auto;

    gap: 14px;

    align-items: end;

    margin-bottom: 14px;

    padding: 16px;

    background: #20293d;

    border:
        1px solid #3b4862;

    border-radius: 9px;
}


.filter-group {
    display: flex;

    flex-direction: column;

    gap: 7px;
}


.filter-group label {
    color: #68758c;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: 0.08em;

    text-transform: uppercase;
}


.filter-group input,
.filter-group select {
    width: 100%;

    height: 38px;

    padding:
        0
        11px;

    border:
        1px solid #2a354a;

    border-radius: 7px;

    outline: none;

    background: #151d2c;

    color: #e7ebf4;

    font: inherit;
    font-size: 12px;
}


.filter-group input:focus,
.filter-group select:focus {
    border-color: #7066d9;
}


.position-filters {
    display: flex;

    gap: 5px;
}


.position-filter {
    height: 38px;

    padding:
        0
        10px;

    border:
        1px solid #2a354a;

    border-radius: 7px;

    background: #151d2c;

    color: #7d899f;

    cursor: pointer;

    font-size: 10px;
    font-weight: 800;
}


.position-filter:hover {
    color: #ffffff;

    border-color: #46516a;
}


.position-filter.active {
    background: #29244a;

    border-color: #7066d9;

    color: #aaa0ff;
}


.filter-actions {
    display: flex;

    align-items: flex-end;
}


.filter-clear {
    height: 38px;

    padding:
        0
        14px;

    border:
        1px solid #2a354a;

    border-radius: 7px;

    background: transparent;

    color: #77849a;

    cursor: pointer;

    font-size: 10px;

    font-weight: 700;
}


.filter-clear:hover {
    color: #ffffff;

    border-color: #46516a;
}


.player-filter-summary {
    margin-bottom: 10px;

    color: #68758c;

    font-size: 10px;
}


.player-filter-summary strong {
    color: #a0aac0;
}


/*
 * ============================================================
 * SORTABLE TABLE
 * ============================================================
 */

.sortable-column {
    cursor: pointer;

    user-select: none;
}


.sortable-column::after {
    margin-left: 5px;

    color: #404b60;

    content: "↕";
}


.sortable-column.active-sort::after {
    color: #9588ff;

    content: "↓";
}


.sortable-column.sort-ascending::after {
    content: "↑";
}


.player-row.hidden-player {
    display: none;
}


@media (
    max-width: 1200px
) {

    .player-filters {
        grid-template-columns:
            repeat(2, minmax(0, 1fr));
    }


    .filter-position {
        grid-column:
            1 / -1;
    }
}


@media (
    max-width: 650px
) {

    .player-filters {
        grid-template-columns:
            1fr;
    }


    .filter-position {
        grid-column:
            auto;
    }


    .position-filters {
        flex-wrap: wrap;
    }
}

/* New Colour Scheme */
/*
 * ============================================================
 * FPL INTELLIGENCE - ACCESSIBILITY / CONTRAST PASS
 * ============================================================
 *
 * Brighter version of the existing dark interface.
 * These overrides intentionally sit at the bottom of app.css.
 */


/*
 * ------------------------------------------------------------
 * APPLICATION BACKGROUND
 * ------------------------------------------------------------
 */

body {
    background: #121827;

    color: #f1f4fa;
}


.app-content {
    background: #121827;
}


/*
 * ------------------------------------------------------------
 * SIDEBAR
 * ------------------------------------------------------------
 */

.sidebar {
    background: #181f30;

    border-right:
        1px solid #34405a;
}


.brand-name {
    color: #ffffff;
}


.brand-version {
    color: #aab5c8;
}


.nav-link {
    color: #b7c1d2;
}


.nav-link:hover {
    background: #232c40;

    color: #ffffff;
}


.nav-link.active {
    background: #302b55;

    color: #c7c0ff;
}


.nav-icon {
    color: #9da9bc;
}


.sidebar-footer {
    color: #9eabc0;
}


/*
 * ------------------------------------------------------------
 * TOP BAR
 * ------------------------------------------------------------
 */

.topbar {
    background: #181f30;

    border-bottom:
        1px solid #34405a;
}


.topbar h1 {
    color: #ffffff;
}


.eyebrow {
    color: #a99fff;
}


.data-status {
    color: #b4bfd1;
}


/*
 * ------------------------------------------------------------
 * DASHBOARD
 * ------------------------------------------------------------
 */

.dashboard {
    background: #121827;
}


.page-description {
    color: #b1bdd0;
}


/*
 * ------------------------------------------------------------
 * CARDS
 * ------------------------------------------------------------
 */

.dashboard-card {
    background: #1b2335;

    border:
        1px solid #34405a;

    box-shadow:
        0 4px 16px
        rgba(0, 0, 0, 0.16);
}


.card-header {
    border-bottom-color: #34405a;
}


.card-header h2 {
    color: #f6f8fc;
}


.card-kicker {
    color: #a99fff;
}


.card-badge {
    background: #2b3450;

    border:
        1px solid #465370;

    color: #c8d0df;
}


/*
 * ------------------------------------------------------------
 * EXPLORER SUMMARY
 * ------------------------------------------------------------
 */

.explorer-stat span {
    color: #a9b5c8;
}


.explorer-stat strong {
    color: #ffffff;
}


/*
 * ------------------------------------------------------------
 * PLAYER FILTERS
 * ------------------------------------------------------------
 */

.player-filters {
    background: #20293d;

    border:
        1px solid #3b4862;
}


.filter-group label {
    color: #aeb9cb;
}


.filter-group input,
.filter-group select {
    background: #151d2d;

    border:
        1px solid #46536d;

    color: #f3f5fa;
}


.filter-group input::placeholder {
    color: #7f8ba0;
}


.filter-group input:hover,
.filter-group select:hover {
    border-color: #63708d;
}


.filter-group input:focus,
.filter-group select:focus {
    border-color: #9287ff;

    box-shadow:
        0 0 0 2px
        rgba(146, 135, 255, 0.15);
}


.position-filter {
    background: #182133;

    border:
        1px solid #46536d;

    color: #b8c2d3;
}


.position-filter:hover {
    background: #263148;

    border-color: #697792;

    color: #ffffff;
}


.position-filter.active {
    background: #41396f;

    border-color: #9287ff;

    color: #ffffff;
}


.filter-clear {
    border-color: #46536d;

    color: #b4bfd0;
}


.filter-clear:hover {
    background: #263148;

    border-color: #697792;

    color: #ffffff;
}


.player-filter-summary {
    color: #9facbf;
}


.player-filter-summary strong {
    color: #e2e7ef;
}


/*
 * ------------------------------------------------------------
 * PLAYER TABLE
 * ------------------------------------------------------------
 */

.player-table th {
    background: #20293d;

    border-bottom:
        1px solid #3c4963;

    color: #aeb9cb;
}


.player-table td {
    border-bottom:
        1px solid #303b51;

    color: #d5dce8;
}


.player-table tbody tr:nth-child(even) {
    background:
        rgba(255, 255, 255, 0.018);
}


.player-table tbody tr:hover {
    background: #263148;
}


.player-name-cell strong {
    color: #ffffff;
}


.rank-column {
    color: #9aa7bb;
}


.position-badge {
    background: #293349;

    border:
        1px solid #46536d;

    color: #dce2ec;
}


/*
 * ------------------------------------------------------------
 * RATINGS
 * ------------------------------------------------------------
 */

.rating-high {
    color: #72e49a;
}


.rating-medium {
    color: #f0d36e;
}


.rating-low {
    color: #ef9b9b;
}


.rating-none {
    color: #8b98ad;
}


.intelligence-score {
    font-weight: 800;
}


/*
 * ------------------------------------------------------------
 * SORTING
 * ------------------------------------------------------------
 */

.sortable-column::after {
    color: #69758b;
}


.sortable-column:hover {
    color: #ffffff;
}


.sortable-column.active-sort::after {
    color: #b3aaff;
}


/*
 * ------------------------------------------------------------
 * FOOTER
 * ------------------------------------------------------------
 */

.footer {
    color: #929fb3;

    border-top-color: #34405a;
}

.player-pool-filters {
    display: flex;

    gap: 5px;
}


.player-pool-filter {
    height: 38px;

    padding:
        0
        12px;

    border:
        1px solid #46536d;

    border-radius: 7px;

    background: #182133;

    color: #b8c2d3;

    cursor: pointer;

    font-size: 10px;

    font-weight: 800;
}


.player-pool-filter:hover {
    background: #263148;

    color: #ffffff;
}


.player-pool-filter.active {
    background: #41396f;

    border-color: #9287ff;

    color: #ffffff;
}